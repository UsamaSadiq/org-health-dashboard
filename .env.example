# Copy to .env and set values for local development.
# Never commit .env — it is gitignored.

# Set to "true" to enable every feature flag regardless of feature_flags.yaml.
# Useful for testing gated features locally or previewing a full feature set
# for a specific client without changing the committed YAML.
#
# Usage:
#   DASHBOARD_ENABLE_ALL_FEATURES=true streamlit run streamlit_app.py
#
DASHBOARD_ENABLE_ALL_FEATURES=false
