{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "rationale", "status"],
        "properties": {
          "name": {"type": "string"},
          "rationale": {"type": "string"},
          "status": {"type": "string", "enum": ["proposed", "phase-2"]},
          "feasibility": {"type": "string"},
          "chaoss_metric": {"type": "string"},
          "scorecard_check": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
